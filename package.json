{
  "name": "doodle-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Doodle UI — a childish, hand-drawn shadcn/ui theme distributed as an npm theme package plus a custom shadcn registry.",
  "homepage": "https://github.com/KareemGhorab/doodle-ui",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @doodle-ui/www dev",
    "build": "pnpm --filter @doodle-ui/www build",
    "build:theme": "pnpm --filter @kareem-hany/theme build",
    "registry:build": "pnpm --filter @doodle-ui/www registry:build",
    "lint": "pnpm --filter @doodle-ui/www lint"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
